<Project Sdk="Microsoft.NET.Sdk">
<!-- General information about the task -->
    <PropertyGroup>
        <!--- The name and description of the task -->
        <PackageId>Frends.HIT.MomentumToRaindance</PackageId>
        <Description>Frends task for converting Momentum ledger note accountings to Raindance import files</Description>
        
        <!--- The version of the task. Can remain at 0.0.1, we specify this manually in the build process -->
        <Version>2.0.0</Version>
        
        <!-- The name of the author -->
        <authors>Höglandets IT</authors>
        
        <!-- The version control system and url -->
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/Hoglandets-IT/Frends.HIT.MomentumToRaindance</RepositoryUrl>
        <PackageProjectUrl>https://github.com/Hoglandets-IT/Frends.HIT.MomentumToRaindance</PackageProjectUrl>
        
        <!-- The .NET framework settings -->
        <TargetFramework>net8.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSource>True</IncludeSource>
        <PackageTags>Frends</PackageTags>
        <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <!-- The copyright notice and licenses-->
        <copyright>Copyright © 2022- Höglandets IT</copyright>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    </PropertyGroup>
    
    <!-- The required .NET packages to run this task -->
    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="Npgsql" Version="8.0.9" />
        <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    </ItemGroup>
        
    <!-- Specify that the FrendsTaskMetadata.json file is included in the package -->
    <ItemGroup>
        <None Include="../docs/package.md" Pack="true" PackagePath="/PACKAGE.md" />
        <None Include="FrendsTaskMetadata.json" Pack="true" PackagePath="/">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Queries\*.graphql" />
        <InternalsVisibleTo Include="Frends.HIT.MomentumToRaindance.Tests" />
        <InternalsVisibleTo Include="Frends.HIT.MomentumToRaindance.Local" />
    </ItemGroup>
</Project>
